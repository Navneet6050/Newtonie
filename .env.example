# Newtonite Local Development Environment Configuration
# Safe defaults for local PostgreSQL container and Spring Boot backend

POSTGRES_DB=newtonite
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite
POSTGRES_PORT=5433

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/newtonite
SPRING_DATASOURCE_USERNAME=newtonite
SPRING_DATASOURCE_PASSWORD=newtonite

SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000

# JWT Authentication Configuration
# Provide a 256-bit+ secret key in production (keep outside version control)
JWT_SECRET=newtonite-insecure-development-jwt-secret-key-32bytes-long-for-hmac-sha256
JWT_EXPIRATION_MS=86400000

# Frontend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api
